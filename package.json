{
  "name": "invoice-generator",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "bash -c 'pkill -9 -f next-server 2>/dev/null || true; sleep 1; rm -rf .next; exec next dev'",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "next lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate-sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:clear": "tsx scripts/clear-db.ts",
    "docs:onboarding": "node scripts/generate-onboarding-docx.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "next": "^14.2.21",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
